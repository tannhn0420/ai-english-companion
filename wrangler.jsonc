// Cloudflare Workers (static assets) — deploy bằng `npx wrangler deploy` (D11).
// Assets-only: không có worker script, chỉ serve dist/ + SPA fallback cho React Router.
{
  "name": "ai-english-companion",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
